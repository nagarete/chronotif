<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Three uses: the updater (Updater.kt) reads GitHub Releases, Search's currency rates
         (ExchangeRates.kt) read the ECB's daily rates, and Usage data (UsageData.kt) sends what
         docs/usage-data.md lists. Nothing from a notification is ever sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 16 requires it for the update jobs' network constraints; the updater also reads whether the network is metered. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Update ready" / "Updated" notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Clock apps only open their alarms screen (tapping the panel clock) for apps that hold
         this. Chronotif never sets an alarm. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- The haptic click when a Lock-screen shortcut is held. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Edge handle overlay + launching the lock-screen view when the screen turns on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Resolve app names/icons for every package that posts notifications (local only). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Search's contacts and calendar events (ADR 0008). Each is asked for only when its switch
         in Settings → Search is turned on, and read only on the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Search's Files (ADR 0023), each asked for only when Find files is turned on in
         Settings → Search, and read only on the phone. All files access lets it find documents;
         the Play build removes it and asks for the media permissions instead. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Search's call buttons, only after "Call from Search" is turned on: WhatsApp starts a call
         only for an app holding this. Phones without telephony can still install Chronotif. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronotif.Setup"
        tools:targetApi="36">

        <!-- The Tutorial's screen, opened from Settings only. -->
        <activity
            android:name=".ui.TutorialActivity"
            android:exported="false" />

        <!-- Settings → Lock screen → Fit to your fingerprint sensor. -->
        <activity
            android:name=".ui.FingerprintFitActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.panel"
            android:theme="@style/Theme.Chronotif.Panel"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".ui.SleepActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.sleep"
            android:theme="@style/Theme.Chronotif.Sleep"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.lock"
            android:theme="@style/Theme.Chronotif.Lock"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- What the QR scanner tile opens: Google Lens, or why it can't scan without it. -->
        <activity
            android:name=".ui.ScanActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.scan"
            android:theme="@style/Theme.Chronotif.Panel" />

        <!-- Search (ADR 0008). Exported so launchers can bind it to their own gestures; it only opens Search. -->
        <activity
            android:name=".ui.SearchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.search"
            android:theme="@style/Theme.Chronotif.Panel"
            android:windowSoftInputMode="adjustNothing|stateAlwaysVisible"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="app.chronotif.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".SearchTile"
            android:exported="true"
            android:icon="@drawable/ic_search"
            android:label="@string/search_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The Chronotif QR scanner tile: opens Google Lens (ADR 0017). -->
        <service
            android:name=".QrTile"
            android:exported="true"
            android:icon="@drawable/ic_qr"
            android:label="@string/qr_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SearchWidget"
            android:exported="true"
            android:label="@string/search_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget" />
        </receiver>

        <receiver
            android:name=".SearchIconWidget"
            android:exported="true"
            android:label="@string/search_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_icon_widget" />
        </receiver>

        <service
            android:name=".ListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".PanelTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Optional status-bar swipe. Needs an accessibility service because only
             accessibility overlays can sit above the status bar. Reads no window content. -->
        <service
            android:name=".StatusBarSwipe"
            android:exported="true"
            android:label="@string/status_swipe_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/status_bar_swipe" />
        </service>

        <!-- Images the user chose to share, copied into our cache and readable only by the app they picked. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
